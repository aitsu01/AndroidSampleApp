<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout del SettingsFragment.
    I titoli e le descrizioni di sezione usano stili da res/values/styles.xml
    invece di attributi inline — se cambia il design basta aggiornare styles.xml.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ── Sezione 1: System prompt ── -->

        <TextView
            style="@style/Stile.TitoloSezione"
            android:text="System prompt" />

        <TextView
            style="@style/Stile.DescrizioneSezione"
            android:text="Istruzioni iniziali che definiscono il comportamento del bot" />

        <EditText
            android:id="@+id/campo_system_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Es: Sei un assistente simpatico che risponde sempre in rima."
            android:inputType="textMultiLine"
            android:minLines="3"
            android:maxLines="8" />

        <!-- Separatore -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="?attr/colorOutline" />

        <!-- ── Sezione 2: Lunghezza risposta ── -->

        <TextView
            style="@style/Stile.TitoloSezione"
            android:text="Lunghezza risposta" />

        <TextView
            style="@style/Stile.DescrizioneSezione"
            android:text="Controlla quanto deve essere lunga la risposta del bot" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_lunghezza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="5"
            android:stepSize="1" />

        <TextView
            android:id="@+id/testo_lunghezza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <!-- Separatore -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="?attr/colorOutline" />

        <!-- ── Sezione 3: Modalità scura ── -->

        <!--
            LinearLayout orizzontale: testo a sinistra, switch a destra.
            Lo switch viene allineato a fine riga grazie a layout_weight="1" sul testo.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Stile.TitoloSezione"
                    android:text="Modalità scura" />

                <TextView
                    style="@style/Stile.DescrizioneSezione"
                    android:layout_marginBottom="0dp"
                    android:text="Cambia l'aspetto dell'app" />

            </LinearLayout>

            <!--
                MaterialSwitch: versione Material3 del classico Switch.
                Il listener è impostato nel fragment tramite setOnCheckedChangeListener.
            -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_modalita_scura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
