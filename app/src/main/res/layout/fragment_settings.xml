<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout del SettingsFragment.
    Contiene i controlli per personalizzare il comportamento del bot.
    ScrollView permette lo scroll se il contenuto non entra nello schermo.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ── Sezione 1: System prompt ── -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System prompt"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="Istruzioni iniziali che definiscono il comportamento del bot"
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Campo di testo multiriga per il system prompt -->
        <EditText
            android:id="@+id/campo_system_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Es: Sei un assistente simpatico che risponde sempre in rima."
            android:inputType="textMultiLine"
            android:minLines="3"
            android:maxLines="8" />

        <!-- Separatore -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="#DDDDDD" />

        <!-- ── Sezione 2: Lunghezza risposta ── -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lunghezza risposta"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="Controlla quanto deve essere lunga la risposta del bot"
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Slider Material: valore da 1 a 5 con step di 1 -->
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_lunghezza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="5"
            android:stepSize="1"/>

        <!-- Etichetta che mostra il valore corrente dello slider in modo leggibile -->
        <TextView
            android:id="@+id/testo_lunghezza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
