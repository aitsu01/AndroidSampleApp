<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
        Palette Dragon Ball.
        Colori ispirati all'universo Dragon Ball: arancione fuoco (gi di Goku)
        e blu profondo (cintura di Goku / cielo).
    -->
    <color name="colore_primario">#E65100</color>        <!-- Arancione Dragon Ball (light mode) -->
    <color name="colore_su_primario">#FFFFFF</color>     <!-- Testo sopra il primario -->
    <color name="colore_secondario">#1565C0</color>      <!-- Blu (accent) -->

    <!--
        Colori per la dark mode: tinte più chiare e desaturate, leggibili su sfondi scuri.
    -->
    <color name="colore_primario_dark">#FF8A65</color>   <!-- Arancione chiaro (dark mode) -->
    <color name="colore_su_primario_dark">#1C0A00</color><!-- Testo scuro sopra l'arancione chiaro -->
    <color name="colore_secondario_dark">#90CAF9</color> <!-- Azzurro chiaro (dark mode) -->
</resources>
